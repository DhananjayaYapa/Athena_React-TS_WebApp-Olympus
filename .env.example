# Application Environment
VITE_APP_ENV=development
VITE_API_BASE=https://api.example.com

# Azure AD B2C Configuration
VITE_AUTHORITY=https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>
VITE_CLIENT_ID=<your-client-id>
VITE_REDIRECT_URL=http://localhost:5173
VITE_POST_REDIRECT_URL=http://localhost:5173
VITE_APP_SCOPE=<your-app-scope>
VITE_APPLICATION_ID=<application-id>

# Service Client IDs
VITE_ATHENA_CLIENT=<athena-client-id>
VITE_HERMES_CLIENT=<hermes-client-id>
VITE_DASHBOARD_CLIENT=<dashboard-client-id>
VITE_HERA_CLIENT=<hera-client-id>
VITE_DEMETER_CLIENT=<demeter-client-id>
